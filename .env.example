# WiseWater Backend Production Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=e7b39a8c2f1d4e6b8a0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f

# SQLite (Default for local development)
DATABASE_URL=sqlite:///./wisewater.db

# PostgreSQL (Production Example)
# DATABASE_URL=postgresql://wisewater_user:SuperSecretPassword@postgres.wisewater.in:5432/wisewater_db

# Security & CORS
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CMP_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://admin.wisewater.in","https://wisewater.in"]

# Payment & SMS Gateway (Optional Production Integrations)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# FAST2SMS_API_KEY=

# Firebase Cloud Messaging (Push Notifications)
# Place your Firebase Admin service account JSON file in backend/firebase-service-account.json
# FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# Or pass the raw JSON string directly in production:
# FIREBASE_CREDENTIALS_JSON=
